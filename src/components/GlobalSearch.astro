---
import { getPublishedComputerPosts, getPublishedReadingPosts, postHref, domainLabel } from '../lib/content';

const computerPosts = await getPublishedComputerPosts();
const readingPosts = await getPublishedReadingPosts();
const records = [
	...computerPosts.map((post) => ({
		title: post.data.title, description: post.data.description, domain: domainLabel(post.data.domain),
		tags: post.data.tags, href: postHref(post, 'computer'), body: post.body,
	})),
	...readingPosts.map((post) => ({
		title: post.data.title, description: post.data.description, domain: domainLabel(post.data.domain),
		tags: post.data.tags, href: postHref(post, 'reading'), body: post.body,
	})),
];
---

<dialog class="search-dialog" id="global-search">
	<div class="search-modal">
		<div class="search-input-wrap"><span aria-hidden="true">⌕</span><input id="global-search-input" type="search" placeholder="搜索标题、正文、标签…" autocomplete="off" /><kbd>ESC</kbd></div>
		<div class="search-hint" id="search-hint"><span>输入关键词开始检索</span><span>{records.length} 篇公开内容</span></div>
		<div class="search-results" id="global-search-results"></div>
		<footer><span>↑↓ 移动</span><span>↵ 打开</span><span>全文本地检索，不上传数据</span></footer>
	</div>
</dialog>
<script type="application/json" id="global-search-data" set:html={JSON.stringify(records)}></script>

<script>
	type SearchRecord = { title: string; description: string; domain: string; tags: string[]; href: string; body: string };
	const dialog = document.querySelector<HTMLDialogElement>('#global-search');
	const input = document.querySelector<HTMLInputElement>('#global-search-input');
	const results = document.querySelector<HTMLElement>('#global-search-results');
	const dataNode = document.querySelector('#global-search-data');
	const records: SearchRecord[] = JSON.parse(dataNode?.textContent || '[]');
	let activeIndex = 0;
	let visibleRecords: SearchRecord[] = [];
	const render = (query: string) => {
		const normalized = query.trim().toLocaleLowerCase();
		visibleRecords = normalized ? records.filter((record) => `${record.title} ${record.description} ${record.domain} ${record.tags.join(' ')} ${record.body}`.toLocaleLowerCase().includes(normalized)).slice(0, 8) : records.slice(0, 5);
		activeIndex = 0;
		if (!results) return;
		results.innerHTML = visibleRecords.length ? visibleRecords.map((record, index) => `<a href="${record.href}" class="${index === 0 ? 'active' : ''}"><span><strong>${record.title}</strong><small>${record.description}</small></span><i>${record.domain} · ${record.tags.slice(0, 2).join(' / ')}</i></a>`).join('') : '<p class="empty-search">没有找到匹配内容，试试更短的关键词。</p>';
	};
	const openSearch = () => { if (!dialog?.open) dialog?.showModal(); render(input?.value || ''); requestAnimationFrame(() => input?.focus()); };
	document.querySelectorAll('[data-open-search], .search-shortcut').forEach((trigger) => trigger.addEventListener('click', (event) => { event.preventDefault(); openSearch(); }));
	document.addEventListener('keydown', (event) => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openSearch(); return; }
		if (!dialog?.open) return;
		if (event.key === 'Escape') dialog.close();
		if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
			event.preventDefault();
			activeIndex = (activeIndex + (event.key === 'ArrowDown' ? 1 : -1) + visibleRecords.length) % visibleRecords.length;
			results?.querySelectorAll('a').forEach((item, index) => item.classList.toggle('active', index === activeIndex));
		}
		if (event.key === 'Enter' && visibleRecords[activeIndex]) location.href = visibleRecords[activeIndex].href;
	});
	input?.addEventListener('input', () => render(input.value));
	dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>

<style>
	.search-dialog{border:0;padding:0;background:transparent;color:var(--text);width:min(720px,calc(100% - 32px));overflow:visible}.search-dialog::backdrop{background:rgba(3,7,16,.72);backdrop-filter:blur(7px)}.search-modal{border:1px solid var(--border-strong);border-radius:18px;overflow:hidden;background:var(--surface);box-shadow:0 30px 100px rgba(0,0,0,.5)}.search-input-wrap{height:68px;display:flex;align-items:center;gap:1rem;padding:0 1.25rem;border-bottom:1px solid var(--border)}.search-input-wrap>span{font-size:1.5rem;color:var(--accent-soft)}.search-input-wrap input{flex:1;border:0;outline:0;background:transparent;color:var(--text);font-size:1.05rem}.search-input-wrap input::placeholder{color:var(--text-muted)}.search-hint{display:flex;justify-content:space-between;padding:.75rem 1.25rem;color:var(--text-muted);font-size:.7rem}.search-results{padding:0 .65rem .65rem;max-height:430px;overflow:auto}.search-results a{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border-radius:11px;color:var(--text-secondary)}.search-results a:hover,.search-results a.active{background:var(--surface-strong);color:var(--text)}.search-results a span{display:grid;gap:.2rem}.search-results strong{font-size:.9rem}.search-results small{color:var(--text-muted)}.search-results i{font-style:normal;font-size:.68rem;color:var(--text-muted);white-space:nowrap}.empty-search{padding:2rem;text-align:center;color:var(--text-muted)}.search-modal>footer{display:flex;gap:1rem;padding:.7rem 1.25rem;border-top:1px solid var(--border);color:var(--text-muted);font-size:.65rem}.search-modal>footer span:last-child{margin-left:auto}@media(max-width:600px){.search-results a{flex-direction:column}.search-results i{white-space:normal}.search-modal>footer span:last-child{display:none}}
</style>
