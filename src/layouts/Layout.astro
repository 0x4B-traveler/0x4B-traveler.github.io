---
import '../styles/global.css';
import GlobalSearch from '../components/GlobalSearch.astro';

export interface Props {
	title: string;
	description?: string;
	activeNav?: 'home' | 'knowledge' | 'portfolio' | 'contributions' | 'reading' | 'about';
	wide?: boolean;
	socialImage?: string | null;
}

const {
	title,
	description = '马超的个人知识库，持续沉淀数据库、云原生、编程语言、算法与阅读笔记。',
	activeNav,
	wide = false,
	socialImage = '/og.png',
} = Astro.props;

const pageTitle = title === '马超 · 个人知识库' ? title : `${title} · 马超的个人知识库`;
const socialImageUrl = socialImage ? new URL(socialImage, Astro.site ?? 'https://0x4b-traveler.github.io/').toString() : null;
const navItems = [
	{ label: '首页', href: '/', id: 'home' },
	{ label: '知识库', href: '/knowledge', id: 'knowledge' },
	{ label: '项目与能力', href: '/portfolio', id: 'portfolio' },
	{ label: '开源贡献', href: '/contributions', id: 'contributions' },
	{ label: '读书', href: '/reading', id: 'reading' },
	{ label: '关于', href: '/about', id: 'about' },
];
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a1020" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const preferredTheme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
			document.documentElement.dataset.theme = savedTheme || preferredTheme;
		</script>
		<title>{pageTitle}</title>
	</head>
	<body>
		<div class="ambient" aria-hidden="true"><span></span><span></span><span></span></div>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/" aria-label="返回首页">
					<span class="brand-mark">M</span>
					<span><strong>马超</strong><small>个人知识库</small></span>
				</a>
				<nav class="desktop-nav" aria-label="主导航">
					{navItems.map((item) => (
						<a href={item.href} aria-current={activeNav === item.id ? 'page' : undefined}>{item.label}</a>
					))}
				</nav>
				<div class="header-actions">
					<a class="search-shortcut" href="/knowledge#search" aria-label="打开搜索"><span>搜索</span><kbd>⌘ K</kbd></a>
					<button class="icon-button" id="theme-toggle" type="button" aria-label="切换明暗主题"><span class="theme-icon">◐</span></button>
					<button class="icon-button menu-toggle" id="menu-toggle" type="button" aria-label="打开菜单" aria-expanded="false">☰</button>
				</div>
			</div>
			<nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航">
				{navItems.map((item) => (
					<a href={item.href} aria-current={activeNav === item.id ? 'page' : undefined}>{item.label}</a>
				))}
			</nav>
		</header>

		<main class:list={['page-shell', { wide }]}><slot /></main>

		<footer class="site-footer">
			<div><strong>马超 · 个人知识库</strong><span>把学过的东西，变成随时可以调用的知识。</span></div>
			<p>© {new Date().getFullYear()} 马超 · Built with Astro</p>
		</footer>
		<GlobalSearch />

		<script is:inline>
			const root = document.documentElement;
			const themeButton = document.querySelector('#theme-toggle');
			themeButton?.addEventListener('click', () => {
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				localStorage.setItem('theme', next);
			});
			const menuButton = document.querySelector('#menu-toggle');
			const mobileNav = document.querySelector('#mobile-nav');
			menuButton?.addEventListener('click', () => {
				const open = mobileNav?.classList.toggle('open') ?? false;
				menuButton.setAttribute('aria-expanded', String(open));
			});
		</script>
	</body>
</html>
