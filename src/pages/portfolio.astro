---
import Layout from '../layouts/Layout.astro';

const capabilities = [
	{ mark: 'DB', title: '数据库与数据系统', description: '从数据模型、索引和事务出发，建立对数据库设计与性能的系统理解。', evidence: [{ label: '数据库系统学习', href: '/knowledge/backend/database/introduction' }] },
	{ mark: 'CN', title: '云原生与分布式架构', description: '关注服务拆分、通信、容器编排以及分布式系统中的一致性问题。', evidence: [{ label: '微服务架构设计', href: '/knowledge/backend/microservices/introduction' }] },
	{ mark: 'FE', title: '前端工程与语言实践', description: '理解 React、Vue 等框架的编程模型，并持续整理性能与工程实践。', evidence: [{ label: 'React 框架学习指南', href: '/knowledge/frontend/react/introduction' }, { label: '前端性能优化指南', href: '/knowledge/frontend/performance/introduction' }] },
	{ mark: 'DS', title: 'Python 与数据结构实践', description: '通过从零实现基础数据结构，理解连续存储、扩缩容策略和操作复杂度。', evidence: [{ label: '动态数组实现', href: 'https://github.com/0x4B-traveler/python-learning-lab/blob/main/data_structures/dynamic_arrary.py' }] },
	{ mark: 'AI', title: '人工智能应用', description: '跟进大语言模型、RAG 与计算机视觉的基础原理和应用方式。', evidence: [{ label: '大模型技术探索', href: '/knowledge/ai/llm/introduction' }] },
];
---

<Layout title="项目与能力" description="用真实项目和文章证明能力，而不是罗列没有上下文的技能词。" activeNav="portfolio" wide>
	<header class="portfolio-hero">
		<div><p class="eyebrow">WORK & CAPABILITIES</p><h1>我如何理解问题，<br /><em>以及如何把它做出来。</em></h1></div>
		<p>这里不放技能进度条。每项能力都由持续沉淀的文章支撑，项目则记录问题、方案与实际结果。</p>
	</header>

	<section class="capability-section">
		<div class="section-heading"><p class="eyebrow">CAPABILITIES</p><h2>能力与证据</h2></div>
		<div class="capability-list">{capabilities.map((item, index) => <article><span class="number">0{index + 1}</span><span class="mark">{item.mark}</span><div class="capability-copy"><h3>{item.title}</h3><p>{item.description}</p></div><div class="evidence"><small>相关沉淀</small>{item.evidence.map((link) => <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>{link.label}<span>↗</span></a>)}</div></article>)}</div>
	</section>

	<section class="project-section">
		<div class="section-heading"><p class="eyebrow">SELECTED PROJECTS</p><h2>项目案例</h2></div>
		<article class="project-card">
			<div class="project-index"><span>01</span><small>PYTHON · DATA STRUCTURES</small></div>
			<div class="project-copy"><p class="project-date">2026.09.01</p><h3>python-learning-lab</h3><p>用 Python 从零实现基础数据结构。当前动态数组以 <code>ctypes.py_object</code> 管理连续存储，在容量耗尽时按 2 倍扩容，并在元素数量降至容量的 1/4 时减半缩容，避免临界点反复扩缩容。</p><div class="project-tags"><span>Dynamic Array</span><span>ctypes</span><span>均摊 O(1)</span></div></div>
			<div class="project-links"><a class="button primary" href="https://github.com/0x4B-traveler/python-learning-lab/blob/main/data_structures/dynamic_arrary.py" target="_blank" rel="noreferrer">查看动态数组实现 <span>↗</span></a><a href="https://github.com/0x4B-traveler/python-learning-lab" target="_blank" rel="noreferrer">浏览完整项目 →</a></div>
		</article>
	</section>
</Layout>

<style>
	.eyebrow{font:700 .68rem var(--font-mono);letter-spacing:.18em;color:var(--accent-soft);margin:0 0 1rem}.portfolio-hero{padding:7rem 0 6rem;display:grid;grid-template-columns:1.4fr .6fr;align-items:end;gap:5rem}.portfolio-hero h1{font-size:clamp(3rem,6vw,5.8rem);line-height:1.03;letter-spacing:-.06em;margin:0}.portfolio-hero h1 em{font-family:var(--font-reading);font-style:normal;font-weight:500;color:transparent;background:linear-gradient(100deg,var(--accent-soft),var(--accent-2));background-clip:text}.portfolio-hero>p{color:var(--text-secondary);line-height:1.9;padding-left:1.5rem;border-left:1px solid var(--border)}.capability-section,.project-section{padding:5rem 0;border-top:1px solid var(--border)}.section-heading h2{font-size:2.2rem;margin:0 0 2.5rem;letter-spacing:-.04em}.capability-list article{display:grid;grid-template-columns:42px 52px 1fr minmax(230px,.7fr);gap:1.5rem;align-items:start;padding:2rem 0;border-top:1px solid var(--border)}.number{font:500 .72rem var(--font-mono);color:var(--text-muted);padding-top:.4rem}.mark{width:46px;height:46px;display:grid;place-items:center;border:1px solid var(--border-strong);border-radius:11px;background:var(--surface);color:var(--accent-soft);font:bold .72rem var(--font-mono)}.capability-copy h3{margin:0 0 .5rem;font-size:1.3rem}.capability-copy p{margin:0;color:var(--text-secondary);font-size:.85rem;line-height:1.75;max-width:570px}.evidence{display:grid;gap:.45rem}.evidence small{color:var(--text-muted);font-size:.65rem}.evidence a{display:flex;justify-content:space-between;padding:.55rem .7rem;border-radius:8px;background:var(--surface);color:var(--text-secondary);font-size:.75rem}.evidence a:hover{color:var(--text);background:var(--surface-strong)}.project-card{display:grid;grid-template-columns:150px 1fr 240px;gap:3rem;align-items:center;padding:2.2rem;border:1px solid var(--border);border-radius:22px;background:linear-gradient(125deg,var(--surface-strong),var(--surface));box-shadow:var(--shadow-sm)}.project-index{align-self:stretch;padding-right:2rem;border-right:1px solid var(--border);display:flex;flex-direction:column;justify-content:space-between}.project-index span{font:300 3.8rem/1 var(--font-mono);color:var(--accent-soft)}.project-index small{font:600 .62rem var(--font-mono);letter-spacing:.12em;color:var(--text-muted)}.project-date{font:600 .65rem var(--font-mono);color:var(--accent-soft);margin:0 0 .6rem}.project-copy h3{font-size:1.8rem;margin:0}.project-copy>p:last-of-type{color:var(--text-secondary);font-size:.85rem;line-height:1.8;max-width:650px}.project-copy code{font-family:var(--font-mono);color:var(--accent-soft)}.project-tags{display:flex;flex-wrap:wrap;gap:.45rem}.project-tags span{padding:.3rem .55rem;border-radius:999px;background:var(--accent-wash);color:var(--accent-soft);font-size:.66rem}.project-links{display:grid;gap:.9rem}.project-links .button{justify-content:space-between}.project-links>a:last-child{text-align:center;font-size:.75rem;font-weight:700}
	@media(max-width:900px){.portfolio-hero{grid-template-columns:1fr;gap:2rem}.capability-list article{grid-template-columns:35px 48px 1fr}.evidence{grid-column:3}.project-card{grid-template-columns:100px 1fr}.project-links{grid-column:2;grid-template-columns:1fr auto;align-items:center}.project-index span{font-size:3rem}}
	@media(max-width:650px){.portfolio-hero{padding:5rem 0 4rem}.portfolio-hero>p{padding-left:0;border:0}.capability-list article{grid-template-columns:42px 1fr;gap:1rem}.number{display:none}.capability-copy{grid-column:2}.evidence{grid-column:2}.project-card{grid-template-columns:1fr;gap:1.5rem;padding:1.4rem}.project-index{min-height:auto;padding:0 0 1rem;border-right:0;border-bottom:1px solid var(--border);flex-direction:row;align-items:end}.project-index small{max-width:130px;text-align:right}.project-links{grid-column:1;grid-template-columns:1fr}.project-links>a:last-child{text-align:left}}
</style>
